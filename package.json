{
  "name": "claude-code-pxy",
  "version": "1.0.0",
  "description": "A proxy server for Claude API with standalone OAuth authentication",
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/main.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage"
  },
  "keywords": [
    "claude",
    "anthropic",
    "proxy",
    "oauth"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "nock": "^13.5.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/static/**"
    ],
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  }
}
